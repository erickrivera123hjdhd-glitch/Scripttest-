-- ===== HWID CHECK (put at the very top of your main loader) =====
do
    local API_BASE = "https://2898-63c2000e84.app.ravenhost.space"
    local API_URL = API_BASE .. "/api/script" -- POST endpoint that checks hwids.txt

    local HttpService = game:GetService("HttpService")

    -- A few executors have no global warn(); degrade to print instead of erroring.
    local function notify(msg)
        if warn then warn(msg) else print(msg) end
    end

    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request
    if not httpRequest then return notify("[HWID] Executor has no HTTP support.") end

    -- Mirror of the server's HWID_RE: 8-256 chars from  A-Za-z0-9 . _ - + = / { }
    -- (#s counts bytes; identical to the server's character count because the
    --  allowed charset is pure ASCII)
    local function isValidHwid(s)
        return type(s) == "string"
            and #s >= 8
            and #s <= 256
            and not s:match("[^A-Za-z0-9%.%_%+%=%/%{%}%-]")
    end

    -- `key` is set by the wrapper you get from "Get Script":  key="<hwid>"; loadstring(...)
    -- It carries the HWID value embedded when that wrapper was generated.
    local rawKey
    do
        local okEnv, env = pcall(getgenv)
        if okEnv and type(env) == "table" then rawKey = env.key end
    end
    rawKey = rawKey or key -- global assigned directly by the wrapper chunk
    local key = tostring(rawKey or ""):match("^%s*(.-)%s*$")

    if key == "" then
        return notify("[HWID] key missing. Use the script from Get Script.")
    end
    if not isValidHwid(key) then
        return notify("[HWID] Invalid key (must be the HWID from your Get Script wrapper).")
    end

    local function getHwid()
        if type(gethwid) == "function" then
            local ok, h = pcall(gethwid)
            if ok and type(h) == "string" and #h > 0 then return h end
        end
        local ok, id = pcall(function() return game:GetService("RbxAnalyticsService"):GetClientId() end)
        if ok and type(id) == "string" and #id > 0 then return id end
    end

    local hwid = getHwid()
    if not hwid then return notify("[HWID] Could not read HWID.") end
    hwid = hwid:match("^%s*(.-)%s*$") -- trim: mirrors the server's .strip()

    if not isValidHwid(hwid) then
        return notify("[HWID] Executor returned an HWID in an unexpected format.")
    end

    -- Exact JSON the aiohttp /api/script endpoint expects:
    --   {"key": "<HWID from the wrapper>", "hwid": "<locally detected HWID>"}
    -- Content-Type must be application/json for aiohttp's request.json().
    local ok, res = pcall(httpRequest, {
        Url = API_URL,
        Method = "POST",
        Headers = { ["Content-Type"] = "application/json" },
        Body = HttpService:JSONEncode({ key = key, hwid = hwid }),
    })

    -- Executors differ on response field casing (Body vs body)
    local data
    if ok and type(res) == "table" then
        local body = res.Body or res.body
        if type(body) == "string" and #body > 0 then
            pcall(function() data = HttpService:JSONDecode(body) end) -- invalid JSON -> data stays nil
        end
    end
    if type(data) ~= "table" then data = nil end -- "true"/"5"/"null" are not valid responses

    if not (data and data.success) then
        local reason
        if data and type(data.message) == "string" and #data.message > 0 then
            reason = data.message -- server's own message, e.g. "HWID not registered or does not match. Register first."
        elseif not ok or type(res) ~= "table" then
            reason = "HWID check failed (request error). Register first."
        elseif data then
            reason = "HWID check failed (server sent no error message). Register first."
        else
            reason = "HWID check failed (HTTP "
                .. tostring(res.StatusCode or res.status_code or res.status or res.code or "?")
                .. ", non-JSON response). Register first."
        end
        return notify("[HWID] " .. reason)
    end

    -- Authorized: fall through and let the main script below run.
    -- data.script is deliberately IGNORED. It contains the loader wrapper
    -- (key="<hwid>"; loadstring(...)); executing or loadstring-ing it here would
    -- re-run this check in an infinite loop. The response exists for
    -- authorization testing only.
end
-- ===== END HWID CHECK =====

-- your main script continues here
loadstring(game:HttpGet("https://raw.githubusercontent.com/erickrivera123hjdhd-glitch/Bathman-lib/refs/heads/Main/CrimsonUI/examples/example.lua"))()
